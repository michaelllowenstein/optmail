{
  "name": "@miloseng/otpmailapi",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant OTP generation/verification and email routing API",
  "type": "commonjs",
  "scripts": {
    "build": "tsx build.ts",
    "start": "node dist/api.js",
    "dev": "nodemon",
    "test": "node --import tsx --test --experimental-test-coverage \"tests/**/*.test.ts\"",
    "test:email": "tsx ./scripts/test-email.ts",
    "clean": "rm -rf dist",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "otp",
    "email",
    "multi-tenant",
    "fastify",
    "api"
  ],
  "author": "Michael Lowenstein",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "pino-pretty": "^13.1.3",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "esbuild": "^0.27.4",
    "esbuild-node-externals": "^1.20.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}