{
  "name": "@miloseng/otpmail",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant OTP + Email workspace — API server and client prototypes",
  "author": "Michael Lowenstein",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "──── LIFECYCLE ────": "",
    "install:all": "pnpm install",
    "clean": "pnpm -r run clean",
    "build": "pnpm -r run build",
    "──── API ────": "",
    "api:dev": "pnpm --filter @miloseng/otpmailapi dev",
    "api:build": "pnpm --filter @miloseng/otpmailapi build",
    "api:start": "pnpm --filter @miloseng/otpmailapi start",
    "api:test": "pnpm --filter @miloseng/otpmailapi test",
    "api:migrate": "pnpm --filter @miloseng/otpmailapi migrate",
    "api:lint": "pnpm --filter @miloseng/otpmailapi lint",
    "api:format": "pnpm --filter @miloseng/otpmailapi format",
    "api:typecheck": "pnpm --filter @miloseng/otpmailapi typecheck",
    "──── REACT CLIENT ────": "",
    "react:dev": "pnpm --filter @miloseng/reactuser dev",
    "react:build": "pnpm --filter @miloseng/reactuser build",
    "react:preview": "pnpm --filter @miloseng/reactuser preview",
    "react:typecheck": "pnpm --filter @miloseng/reactuser typecheck",
    "──── VUE CLIENT ────": "",
    "vue:dev": "pnpm --filter @miloseng/vueuser dev",
    "vue:build": "pnpm --filter @miloseng/vueuser build",
    "vue:preview": "pnpm --filter @miloseng/vueuser preview",
    "vue:typecheck": "pnpm --filter @miloseng/vueuser typecheck",
    "──── ANGULAR CLIENT ────": "",
    "ng:dev": "pnpm --filter @miloseng/nguser start",
    "ng:build": "pnpm --filter @miloseng/nguser build",
    "ng:typecheck": "pnpm --filter @miloseng/nguser typecheck",
    "──── CROSS-CUTTING ────": "",
    "dev": "pnpm -r --parallel run dev",
    "dev:api+react": "pnpm --filter @miloseng/otpmailapi --filter @miloseng/reactuser --parallel run dev",
    "dev:api+vue": "pnpm --filter @miloseng/otpmailapi --filter @miloseng/vueuser --parallel run dev",
    "dev:api+ng": "pnpm --filter @miloseng/otpmailapi --filter @miloseng/nguser --parallel run dev start",
    "dev:clients": "pnpm --filter './clients/*' --parallel run dev",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "typecheck": "pnpm -r run typecheck",
    "──── INFRASTRUCTURE ────": "",
    "db:up": "docker compose -f otpmailapi/docker-compose.yml up -d",
    "db:down": "docker compose -f otpmailapi/docker-compose.yml down",
    "db:reset": "docker compose -f otpmailapi/docker-compose.yml down -v && docker compose -f otpmailapi/docker-compose.yml up -d",
    "db:logs": "docker compose -f otpmailapi/docker-compose.yml logs -f postgres",
    "db:psql": "docker exec -it otp-email-db psql -U otp_api -d otp_email_api"
  }
}
